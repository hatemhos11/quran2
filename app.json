{
	"expo": {
		"name": "quran",
		"slug": "quran2",
		"version": "1.0.0",
		"orientation": "default",
		"icon": "./assets/images/icon.png",
		"scheme": "quran2",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/images/icon.png",
			"supportsTablet": true,
			"bundleIdentifier": "com.hatemhos111.quran2",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"supportsRtl": true,
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#003030"
			},
			"package": "com.hatemhos111.quran2"
		},
		"web": {
			"output": "single",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#003030",
					"image": "./assets/images/splash.png",
					"resizeMode": "cover"
				}
			],
			[
				"expo-localization",
				{
					"supportedLocales": {
						"ios": ["ar"],
						"android": ["ar"]
					}
				}
			],
			"expo-sqlite",
			"expo-font"
		],
		"extra": {
			"supportsRTL": true,
			"eas": {
				"projectId": "1cdb11c5-c303-4927-9e3b-2f7e37c6db56"
			}
		}
	}
}
